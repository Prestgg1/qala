{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@qala/core": ["./packages/core/src/index.ts"],
      "@qala/core/query": ["./packages/core/src/orm/builder/index.ts"],
      "@qala/client": ["./packages/client/src/index.ts"]
    }
  }
}
