{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "bun"
    ],
    "paths": {
      "@qala/core": [
        "../../packages/core/src/index.ts"
      ],
      "@qala/client": [
        "../../packages/client/src/index.ts"
      ],
      "@qala/core/query": [
        "../../packages/core/src/orm/builder/index.ts"
      ],
      "@qala/core/testing": [
        "../../packages/core/src/testing.ts"
      ]
    }
  },
  "include": [
    "app",
    ".qala/**/*.ts",
    "web",
    "test",
    "bench"
  ]
}
